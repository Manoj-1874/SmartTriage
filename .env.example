# SmartTriage Dashboard - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ═══════════════════════════════════════════════════════════
# FLASK CONFIGURATION
# ═══════════════════════════════════════════════════════════
FLASK_SECRET_KEY=your-secret-key-here-change-this-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# ═══════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════
# SQLite (Development - Default)
DATABASE_URL=sqlite:///triage.db

# PostgreSQL (Production - Recommended)
# DATABASE_URL=postgresql://username:password@localhost:5432/smarttriage
# Or use DATABASE_TYPE=postgresql and set individual parameters:
# DATABASE_TYPE=sqlite
# POSTGRES_USER=smarttriage_user
# POSTGRES_PASSWORD=your-secure-password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=smarttriage

# ═══════════════════════════════════════════════════════════
# HUGGING FACE CONFIGURATION
# ═══════════════════════════════════════════════════════════
# Set to 'true' to load models from Hugging Face Hub
# Set to 'false' to use local models
USE_HUGGINGFACE=false
HF_REPO_ID=Manoj-palanisamy/smarttriage-models
HF_TOKEN=your-huggingface-token-here-optional

# ═══════════════════════════════════════════════════════════
# EMAIL CONFIGURATION (for verification emails)
# ═══════════════════════════════════════════════════════════
SMTP_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=noreply@prioritymed.com
SMTP_FROM_NAME=PriorityMed

# ═══════════════════════════════════════════════════════════
# SECURITY CONFIGURATION
# ═══════════════════════════════════════════════════════════
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600
PASSWORD_MIN_LENGTH=8

# ═══════════════════════════════════════════════════════════
# RATE LIMITING CONFIGURATION
# ═══════════════════════════════════════════════════════════
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URL=memory://
# For Redis (Production): redis://localhost:6379/0
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_LOGIN=5 per minute
RATELIMIT_SIGNUP=3 per hour
RATELIMIT_TRIAGE=10 per minute

# ═══════════════════════════════════════════════════════════
# APPLICATION CONFIGURATION
# ═══════════════════════════════════════════════════════════
APP_NAME=PriorityMed
APP_HOST=0.0.0.0
APP_PORT=5000
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt,csv,xlsx

# SmartTriage Dashboard - Production Environment Variables
# Copy this to .env for production deployment
# IMPORTANT: Generate new secret keys and passwords

# Flask Configuration
FLASK_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY_USE_secrets.token_hex(32)
FLASK_ENV=production
FLASK_DEBUG=False

# Database Configuration (PostgreSQL recommended for production)
DATABASE_URL=postgresql://smarttriage_user:SECURE_PASSWORD_HERE@localhost:5432/smarttriage
# OR for SQLite (not recommended for production):
# DATABASE_URL=sqlite:///triage.db

# PostgreSQL Configuration (if using PostgreSQL)
POSTGRES_USER=smarttriage_user
POSTGRES_PASSWORD=SECURE_PASSWORD_HERE
POSTGRES_DB=smarttriage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# Application Port
APP_PORT=5000

# Hugging Face Configuration
USE_HUGGINGFACE=false
HF_REPO_ID=Manoj-palanisamy/smarttriage-models

# Email Configuration (SMTP for production)
SMTP_ENABLED=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@smarttriage.com

# Security Configuration
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# CORS Configuration (if needed)
CORS_ENABLED=false
CORS_ORIGINS=https://yourdomain.com

# Security Features
SECURITY_HEADERS_ENABLED=true
REQUEST_ID_ENABLED=true
AUDIT_LOGGING_ENABLED=true

# Rate Limiting Configuration (Redis recommended for production)
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URL=redis://localhost:6379/0
# OR for testing: RATELIMIT_STORAGE_URL=memory://
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_LOGIN=5 per minute
RATELIMIT_SIGNUP=3 per hour
RATELIMIT_TRIAGE=10 per minute

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/smarttriage.log
ERROR_LOG_FILE=logs/errors.log
AUDIT_LOG_FILE=logs/audit.log
